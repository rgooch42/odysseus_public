# .env.local — Private bridge config for docker.local MCP endpoints
# Copy to .env.local and fill in real values. This file is gitignored.
# Load alongside .env at startup (or merge manually).

# ── BeatriceRouter MCP servers ──────────────────────────────────────────────
# Model capability router (coder vs. general dispatch)
ODYSSEUS_MCP_MODEL_ROUTER_URL=http://docker.local:10040
ODYSSEUS_MCP_MODEL_ROUTER_HEADERS={"Authorization": "Bearer <ROUTER_SERVICE_TOKEN>"}

# SearXNG-backed web research
ODYSSEUS_MCP_RESEARCH_URL=http://docker.local:10020
ODYSSEUS_MCP_RESEARCH_HEADERS={"Authorization": "Bearer <RESEARCH_MCP_TOKEN>"}

# SecondBrain vault (notes, tasks, handoffs)
ODYSSEUS_MCP_SB_URL=http://docker.local:10010
ODYSSEUS_MCP_SB_HEADERS={"Authorization": "Bearer <SB_MCP_TOKEN>"}

# Remote shell on docker.local
ODYSSEUS_MCP_SHELL_URL=http://docker.local:10030
ODYSSEUS_MCP_SHELL_HEADERS={"Authorization": "Bearer <SHELL_MCP_TOKEN>"}

# Remote file workspace on docker.local
ODYSSEUS_MCP_WORKSPACE_URL=http://docker.local:10031
ODYSSEUS_MCP_WORKSPACE_HEADERS={"Authorization": "Bearer <WORKSPACE_MCP_TOKEN>"}

# Sandbox container pool (agent task execution)
ODYSSEUS_MCP_SANDBOX_URL=http://docker.local:10050
ODYSSEUS_MCP_SANDBOX_HEADERS={"Authorization": "Bearer <SANDBOX_MCP_TOKEN>"}
